  "fields": [
    {
      "id": "kanji",
      "label": "漢字（一文字）",
      "type": "text",
      "default": "挑",
      "required": true,
      "maxLength": 1,
      "placeholder": "例: 挑",
      "help": "一文字だけ入力できます"
    },
    {
      "id": "year",
      "label": "年",
      "type": "text",
      "default": "2026",
      "required": true,
      "maxLength": 4
    },
    {
      "id": "name",
      "label": "揮毫（書いた人）",
      "type": "text",
      "default": "ジェネ家　わたし",
      "maxLength": 12,
      "help": "和紙の左側に縦書きで入ります"
    },
    {
      "id": "organizer",
      "label": "主催",
      "type": "text",
      "default": "ジェネ家 漢字選定委員会",
      "maxLength": 20
