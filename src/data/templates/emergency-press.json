    {
      "id": "org",
      "label": "組織名（背景パネル）",
      "type": "text",
      "default": "わが家",
      "required": true,
      "maxLength": 12
    },
    {
      "id": "presenter",
      "label": "発表者（名札）",
      "type": "text",
      "default": "父　ジェネ太郎",
      "required": true,
      "maxLength": 14
    },
    {
      "id": "announcement",
      "label": "発表内容（字幕）",
      "type": "textarea",
      "default": "本日をもちまして、夜ふかしを卒業することをここに宣言いたします",
      "required": true,
      "maxLength": 60
    },
    {
      "id": "date",
      "label": "日付",
      "type": "date",
      "default": "today"
    },
    {
      "id": "time",
      "label": "時刻",
      "type": "text",
      "default": "15:00",
      "maxLength": 5,
      "placeholder": "例: 15:00"
